---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoPlaceholder from "../../components/VideoPlaceholder.astro";
import { tutorialVideos } from "../../data/videos";
---

<BaseLayout
  title="Videoguías | Física de la Atmósfera"
  description="Tutoriales audiovisuales para aprender a utilizar SENAMHI Bolivia y Ventusky."
>
  <section class="section tutorials" aria-labelledby="tutoriales-title">
    <div class="shell">
      <h2 id="tutoriales-title" class="sr-only">Tutoriales disponibles</h2>
      {tutorialVideos.map((video, index) => (
        <article id={video.id} class:list={["tutorial", index % 2 === 1 && "tutorial-reverse"]}>
          <div class="tutorial-copy">
            <span class="tutorial-number">{String(index + 1).padStart(2, "0")}</span>
            <p class="eyebrow">{video.platform}</p>
            <h2>{video.title}</h2>
            <p>{video.description}</p>
            <span class="duration">{video.duration}</span>
            <a class="text-link" href={`/pronostico/#${video.id}`}>Conocer la plataforma <span class="arrow">→</span></a>
          </div>
          <VideoPlaceholder id={video.id} title={video.title} youtubeId={video.youtubeId} />
        </article>
      ))}
    </div>
  </section>

  <section class="practice-section">
    <div class="shell practice-card">
      <span aria-hidden="true">?</span>
      <div>
        <p class="eyebrow">Antes de abrir un mapa</p>
        <h2>Entendé primero las variables.</h2>
        <p>La guía introductoria explica la base física y química de los elementos climáticos.</p>
      </div>
      <a class="button button-accent" href="/guias/introduccion-al-clima/">Introducción al clima →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .tutorials { padding-block: 30px 90px; }

  .tutorial {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(480px, 1.28fr);
    align-items: center;
    gap: clamp(38px, 8vw, 90px);
    padding-block: 74px;
    border-bottom: 1px solid var(--line);
  }

  .tutorial-reverse .tutorial-copy { order: 2; }
  .tutorial-reverse :global(.video-frame) { order: 1; }

  .tutorial-number {
    display: block;
    margin-bottom: 18px;
    color: var(--blue);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .tutorial h2 {
    margin: 4px 0 17px;
    color: var(--navy);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1.06;
  }

  .tutorial-copy > p:not(.eyebrow) { color: var(--muted); }

  .duration {
    display: inline-flex;
    margin: 11px 0 22px;
    border-radius: 999px;
    background: var(--surface);
    padding: 6px 11px;
    color: var(--muted);
    font-size: 0.73rem;
    font-weight: 800;
  }

  .tutorial .text-link { display: flex; width: fit-content; }

  .practice-section { background: var(--blue-soft); padding-block: 74px; }

  .practice-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 28px;
    border-radius: 26px;
    background: var(--navy);
    padding: clamp(28px, 5vw, 48px);
    color: var(--white);
  }

  .practice-card > span {
    display: grid;
    width: 72px;
    height: 72px;
    place-items: center;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--navy);
    font-size: 2rem;
    font-weight: 900;
  }

  .practice-card .eyebrow { color: var(--cyan); }
  .practice-card h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.3rem); }
  .practice-card p:last-child { margin: 6px 0 0; color: rgba(255, 255, 255, 0.68); }

  @media (max-width: 850px) {
    .tutorial { grid-template-columns: 1fr; }
    .tutorial-reverse .tutorial-copy, .tutorial-reverse :global(.video-frame) { order: initial; }
    .practice-card { grid-template-columns: auto 1fr; }
    .practice-card .button { grid-column: 1 / -1; }
  }

  @media (max-width: 600px) {
    .guides-count { width: 125px; height: 125px; }
    .guides-count strong { font-size: 3rem; }
    .tutorial { padding-block: 54px; }
    .practice-card { grid-template-columns: 1fr; }
  }
</style>
