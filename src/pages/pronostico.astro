---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlatformSection from "../components/PlatformSection.astro";
import { platforms } from "../data/platforms";
---

<BaseLayout
  title="Plataformas climáticas | Física de la Atmósfera"
  description="Guía detallada para consultar SENAMHI Bolivia, Ventusky, NASA Earthdata, Copernicus y Earth NullSchool."
>
  <div class="platform-list">
    {platforms.map((platform, index) => (
      <>
        <PlatformSection platform={platform} index={index} />

      </>
    ))}
  </div>
</BaseLayout>

<style>
  .directory-cta {
    padding-block: 82px;
    background: var(--blue-soft);
  }

  .cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    border-radius: 28px;
    background: var(--navy);
    padding: clamp(30px, 6vw, 58px);
    color: var(--white);
  }

  .cta-card .eyebrow { color: var(--cyan); }
  .cta-card h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.05; }
  .cta-card p:last-child { max-width: 670px; margin-bottom: 0; color: rgba(255, 255, 255, 0.68); }
  .cta-card .button { flex: 0 0 auto; }

  @media (max-width: 800px) {
    .cta-card { align-items: flex-start; flex-direction: column; }
  }
</style>
