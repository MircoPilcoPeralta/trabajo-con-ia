---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CITIES } from "../lib/openMeteo";
---

<BaseLayout
  title="Comparar ciudades | Física de la Atmósfera"
  description="Compará en tiempo real temperatura, humedad, viento y presión entre ciudades bolivianas."
>
  <section class="section compare-section" aria-labelledby="compare-title">
    <div class="shell">
      <h2 id="compare-title" class="sr-only">Seleccionar ciudades para comparar</h2>
      <div class="compare-controls">
        <label><span>Ciudad A</span><select id="city-a">{CITIES.map(city => <option value={city.id} selected={city.id === "la-paz"}>{city.name}</option>)}</select></label>
        <span class="versus" aria-hidden="true">VS</span>
        <label><span>Ciudad B</span><select id="city-b">{CITIES.map(city => <option value={city.id} selected={city.id === "santa-cruz"}>{city.name}</option>)}</select></label>
        <button id="compare-button" class="button" type="button">Actualizar comparación</button>
      </div>

      <p id="compare-status" class="compare-status" role="status" aria-live="polite">Consultando datos actuales…</p>

      <div class="city-headings">
        <article class="city-a-heading"><span>A</span><div><strong id="name-a">La Paz</strong><small id="elevation-a">-- m s. n. m.</small></div></article>
        <article class="city-b-heading"><span>B</span><div><strong id="name-b">Santa Cruz</strong><small id="elevation-b">-- m s. n. m.</small></div></article>
      </div>

      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <thead><tr><th>Variable</th><th id="table-name-a">La Paz</th><th id="table-name-b">Santa Cruz</th><th>Diferencia</th></tr></thead>
          <tbody>
            <tr><th>Temperatura</th><td id="temp-a">--</td><td id="temp-b">--</td><td id="temp-diff">--</td></tr>
            <tr><th>Humedad relativa</th><td id="humidity-a">--</td><td id="humidity-b">--</td><td id="humidity-diff">--</td></tr>
            <tr><th>Viento</th><td id="wind-a">--</td><td id="wind-b">--</td><td id="wind-diff">--</td></tr>
            <tr><th>Presión superficial</th><td id="pressure-a">--</td><td id="pressure-b">--</td><td id="pressure-diff">--</td></tr>
            <tr><th>PM2.5 modelado</th><td id="pm-a">--</td><td id="pm-b">--</td><td id="pm-diff">--</td></tr>
          </tbody>
        </table>
      </div>

      <section class="chart-card" aria-labelledby="chart-title">
        <div><p class="eyebrow">Lectura visual</p><h2 id="chart-title">Diferencias relativas</h2></div>
        <div id="compare-bars" class="compare-bars"></div>
      </section>

      <div class="interpret-grid">
        <article><span>ALT</span><h3>Revisá la altitud</h3><p>La presión superficial disminuye con la altura. Por eso no debe confundirse con la presión reducida al nivel del mar.</p></article>
        <article><span>REL</span><h3>Buscá relaciones</h3><p>Temperatura y humedad relativa cambian juntas, pero no describen por sí solas cuánto vapor contiene el aire.</p></article>
        <article><span>ESC</span><h3>Considerá la escala</h3><p>La calidad del aire proviene de un modelo global de aproximadamente 45 km, no de sensores urbanos.</p></article>
      </div>

      <div class="study-viewer-callout">
        <button style="margin: auto;" id="study-open" class="button button-accent" type="button">Comparaciones de datos</button>
      </div>
    </div>
  </section>

  <dialog id="study-viewer" class="study-viewer" aria-labelledby="study-title">
    <div class="study-viewer-header"><h2 id="study-title">Estudio comparativo</h2><button id="study-close" type="button" aria-label="Cerrar visualizador">×</button></div>
    <object class="study-pdf" data="/estudio-comparativo.pdf" type="application/pdf">
      <p>Tu navegador no puede mostrar el PDF. <a href="/estudio-comparativo.pdf" target="_blank" rel="noopener">Abrir el estudio comparativo</a>.</p>
    </object>
  </dialog>

  <script>
    import { CITIES, loadClimateData } from "../lib/openMeteo";

    const selectA = document.querySelector<HTMLSelectElement>("#city-a");
    const selectB = document.querySelector<HTMLSelectElement>("#city-b");
    const button = document.querySelector<HTMLButtonElement>("#compare-button");
    const status = document.querySelector<HTMLElement>("#compare-status");
    const studyOpen = document.querySelector<HTMLButtonElement>("#study-open");
    const studyClose = document.querySelector<HTMLButtonElement>("#study-close");
    const studyViewer = document.querySelector<HTMLDialogElement>("#study-viewer");

    const set = (id: string, value: string) => {
      const node = document.querySelector<HTMLElement>(`#${id}`);
      if (node) node.textContent = value;
    };

    const format = (value: number, digits = 0) => new Intl.NumberFormat("es-BO", { maximumFractionDigits: digits }).format(value);
    const difference = (a: number, b: number, unit: string, digits = 0) => `${format(Math.abs(a - b), digits)} ${unit}`;

    async function compare() {
      const cityA = CITIES.find(city => city.id === selectA?.value) ?? CITIES[1];
      const cityB = CITIES.find(city => city.id === selectB?.value) ?? CITIES[2];
      if (!cityA || !cityB) return;
      if (cityA.id === cityB.id) {
        if (status) status.textContent = "Elegí dos ciudades diferentes para comparar.";
        return;
      }

      button?.setAttribute("disabled", "true");
      if (status) status.textContent = "Consultando ambos puntos…";
      try {
        const [dataA, dataB] = await Promise.all([loadClimateData(cityA), loadClimateData(cityB)]);
        const a = dataA.forecast.current;
        const b = dataB.forecast.current;
        set("name-a", cityA.name); set("table-name-a", cityA.name); set("elevation-a", `${format(dataA.forecast.elevation)} m s. n. m.`);
        set("name-b", cityB.name); set("table-name-b", cityB.name); set("elevation-b", `${format(dataB.forecast.elevation)} m s. n. m.`);
        set("temp-a", `${format(a.temperature_2m, 1)} °C`); set("temp-b", `${format(b.temperature_2m, 1)} °C`); set("temp-diff", difference(a.temperature_2m, b.temperature_2m, "°C", 1));
        set("humidity-a", `${format(a.relative_humidity_2m)} %`); set("humidity-b", `${format(b.relative_humidity_2m)} %`); set("humidity-diff", difference(a.relative_humidity_2m, b.relative_humidity_2m, "%"));
        set("wind-a", `${format(a.wind_speed_10m, 1)} km/h`); set("wind-b", `${format(b.wind_speed_10m, 1)} km/h`); set("wind-diff", difference(a.wind_speed_10m, b.wind_speed_10m, "km/h", 1));
        set("pressure-a", `${format(a.surface_pressure, 1)} hPa`); set("pressure-b", `${format(b.surface_pressure, 1)} hPa`); set("pressure-diff", difference(a.surface_pressure, b.surface_pressure, "hPa", 1));
        const pmA = dataA.airQuality?.current.pm2_5;
        const pmB = dataB.airQuality?.current.pm2_5;
        set("pm-a", pmA === undefined ? "No disponible" : `${format(pmA, 1)} µg/m³`);
        set("pm-b", pmB === undefined ? "No disponible" : `${format(pmB, 1)} µg/m³`);
        set("pm-diff", pmA === undefined || pmB === undefined ? "--" : difference(pmA, pmB, "µg/m³", 1));

        const bars = document.querySelector<HTMLElement>("#compare-bars");
        const rows = [
          { label: "Temperatura", a: a.temperature_2m, b: b.temperature_2m, max: 45, unit: "°C" },
          { label: "Humedad", a: a.relative_humidity_2m, b: b.relative_humidity_2m, max: 100, unit: "%" },
          { label: "Viento", a: a.wind_speed_10m, b: b.wind_speed_10m, max: Math.max(a.wind_speed_10m, b.wind_speed_10m, 40), unit: "km/h" },
          { label: "Presión", a: a.surface_pressure, b: b.surface_pressure, max: 1050, unit: "hPa" },
        ];
        if (bars) bars.innerHTML = rows.map(row => `<div class="bar-row"><strong>${row.label}</strong><div><span class="bar-a" style="width:${Math.max(3, row.a / row.max * 100)}%">${format(row.a, 1)} ${row.unit}</span></div><div><span class="bar-b" style="width:${Math.max(3, row.b / row.max * 100)}%">${format(row.b, 1)} ${row.unit}</span></div></div>`).join("");
        if (status) status.textContent = `Datos del ${a.time.replace("T", " a las ")}.`;
      } catch {
        if (status) status.textContent = "No fue posible actualizar la comparación. Intentá nuevamente.";
      } finally {
        button?.removeAttribute("disabled");
      }
    }

    button?.addEventListener("click", compare);
    studyOpen?.addEventListener("click", () => studyViewer?.showModal());
    studyClose?.addEventListener("click", () => studyViewer?.close());
    studyViewer?.addEventListener("click", (event) => {
      if (event.target === studyViewer) studyViewer.close();
    });
    compare();
  </script>
</BaseLayout>

<style>
  .compare-controls { display:grid; grid-template-columns:1fr auto 1fr auto; align-items:end; gap:14px; border:1px solid var(--line); border-radius:22px; background:var(--surface); padding:22px; }
  .compare-controls label span { display:block; margin-bottom:5px; color:var(--muted); font-size:.7rem; font-weight:850; text-transform:uppercase; }
  .compare-controls select { width:100%; min-height:48px; border:1px solid var(--line); border-radius:12px; background:var(--white); padding:9px 36px 9px 12px; color:var(--navy); font-weight:800; }
  .versus { display:grid; width:42px; height:42px; place-items:center; border-radius:50%; background:var(--yellow); color:var(--navy); font-size:.7rem; font-weight:900; }
  .compare-controls button:disabled { cursor:wait; opacity:.65; }
  .compare-status { min-height:25px; margin:12px 0 24px; color:var(--muted); font-size:.8rem; }
  .city-headings { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px; }
  .city-headings article { display:flex; align-items:center; gap:14px; border-radius:18px; padding:20px; color:var(--white); }
  .city-a-heading { background:var(--navy); } .city-b-heading { background:var(--blue); }
  .city-headings article>span { display:grid; width:42px; height:42px; place-items:center; border-radius:50%; background:rgba(255,255,255,.16); font-weight:900; }
  .city-headings strong,.city-headings small { display:block; } .city-headings strong{font-size:1.3rem}.city-headings small{opacity:.7}
  .comparison-table-wrap { overflow-x:auto; border:1px solid var(--line); border-radius:20px; }
  .comparison-table { width:100%; min-width:720px; border-collapse:collapse; }
  .comparison-table th,.comparison-table td { border-bottom:1px solid var(--line); padding:17px 20px; text-align:left; }
  .comparison-table thead { background:var(--navy); color:var(--white); } .comparison-table tbody th{color:var(--navy)} .comparison-table td{color:var(--muted);font-weight:750}
  .chart-card { margin-top:24px; border-radius:22px; background:var(--surface); padding:clamp(24px,5vw,44px); }
  .chart-card h2 { margin:0 0 28px; color:var(--navy); font-size:clamp(1.7rem,3vw,2.5rem); }
  .compare-bars { display:grid; gap:22px; }
  :global(.bar-row) { display:grid; grid-template-columns:130px 1fr 1fr; align-items:center; gap:13px; }
  :global(.bar-row>strong) { color:var(--navy); font-size:.78rem; }
  :global(.bar-row>div) { overflow:hidden; border-radius:999px; background:#e2e8f1; }
  :global(.bar-row span) { display:block; min-width:max-content; border-radius:999px; padding:7px 10px; color:var(--white); font-size:.68rem; font-weight:800; }
  :global(.bar-a) { background:var(--navy); } :global(.bar-b) { background:var(--blue); }
  .interpret-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:24px; }
  .interpret-grid article { border:1px solid var(--line); border-radius:18px; padding:24px; }
  .interpret-grid span { color:var(--blue); font-size:.7rem; font-weight:900; }
  .interpret-grid h3 { margin:20px 0 7px; color:var(--navy); }
   .interpret-grid p { margin:0; color:var(--muted); font-size:.82rem; }
   .study-viewer-callout { display:flex; align-items:center; justify-content:space-between; gap:28px; margin-top:24px; border-radius:22px; background:var(--blue-soft); padding:clamp(24px,4vw,38px); }
   .study-viewer-callout .eyebrow { margin:0; } .study-viewer-callout h2 { margin:5px 0 8px; color:var(--navy); } .study-viewer-callout p:last-child { margin:0; color:var(--muted); }
   .study-viewer { width:min(1100px,94vw); max-height:92vh; overflow:auto; border:0; border-radius:22px; padding:0; box-shadow:0 24px 80px rgba(0,0,0,.35); }
   .study-viewer::backdrop { background:rgba(7,27,51,.75); backdrop-filter:blur(4px); }.study-viewer-header { position:sticky; top:0; display:flex; align-items:center; justify-content:space-between; z-index:1; background:var(--white); padding:16px 20px; }.study-viewer-header h2 { margin:0; color:var(--navy); font-size:1.2rem; }.study-viewer-header button { width:38px; height:38px; border:0; border-radius:50%; background:var(--surface); color:var(--navy); cursor:pointer; font-size:1.7rem; line-height:1; }.study-pdf { display:block; width:100%; height:min(78vh,1000px); border:0; background:var(--white); }.study-pdf p { padding:24px; }
   @media(max-width:850px){.compare-controls{grid-template-columns:1fr auto 1fr}.compare-controls .button{grid-column:1/-1}.interpret-grid{grid-template-columns:1fr}:global(.bar-row){grid-template-columns:90px 1fr 1fr}}
   @media(max-width:580px){.compare-controls{grid-template-columns:1fr}.versus{margin:auto}.city-headings{grid-template-columns:1fr}.study-viewer-callout{align-items:flex-start; flex-direction:column}:global(.bar-row){grid-template-columns:1fr}:global(.bar-row>div){min-height:31px}}
</style>
