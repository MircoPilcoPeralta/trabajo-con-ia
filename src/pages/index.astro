---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CITIES } from "../lib/openMeteo";
import sunIcon from "../../assets/sol.svg";
import cloudIcon from "../../assets/nube.svg";
import landscape from "../../assets/fondo.svg";
import humidityIcon from "../../assets/humedad.svg";
import windIcon from "../../assets/viento.svg";
import temperatureIcon from "../../assets/temperatura.svg";
import pressureIcon from "../../assets/presion.svg";
---

<BaseLayout
  title="Física de la Atmósfera | Clima y aprendizaje"
  description="Consulta el tiempo en Bolivia y aprende a interpretar datos atmosféricos con recursos y plataformas climáticas."
>
  <section class="weather-section" aria-labelledby="clima-actual">
    <div class="shell">
      <div class="weather-toolbar">
        <h1 id="clima-actual">Clima actual</h1>
        <label class="city-control">
          <span>Ciudad</span>
          <select id="city-select" aria-label="Seleccionar ciudad boliviana">
            {CITIES.map((city) => <option value={city.id}>{city.name}, {city.department}</option>)}
          </select>
        </label>
      </div>

      <div id="weather-dashboard" class="weather-dashboard" aria-busy="true">
        <div class="current-column">
          <article class="current-card">
          <div class="current-topline">
            <div>
              <p id="weather-location" class="weather-location">Sacaba, Cochabamba</p>
              <p id="weather-updated" class="weather-updated">Actualizando datos…</p>
            </div>
            <button id="weather-refresh" class="refresh-button" type="button" aria-label="Actualizar datos meteorológicos">↻</button>
          </div>

          <div class="temperature-row">
            <span class="weather-art" aria-hidden="true"><img class="weather-sun" src={sunIcon.src} width={sunIcon.width} height={sunIcon.height} alt="" /><img class="weather-cloud" src={cloudIcon.src} width={cloudIcon.width} height={cloudIcon.height} alt="" /></span>
            <div>
              <strong id="weather-temperature" class="temperature">--°</strong>
              <p><span id="weather-symbol" aria-hidden="true">○</span> <span id="weather-condition">Consultando el cielo</span></p>
            </div>
          </div>

          <dl class="metric-grid">
            <div><img src={humidityIcon.src} width={humidityIcon.width} height={humidityIcon.height} alt="" /><span><dt>Humedad</dt><dd id="weather-humidity">--%</dd></span></div>
            <div><img src={windIcon.src} width={windIcon.width} height={windIcon.height} alt="" /><span><dt>Viento</dt><dd id="weather-wind">-- km/h</dd></span></div>
            <div><img src={temperatureIcon.src} width={temperatureIcon.width} height={temperatureIcon.height} alt="" /><span><dt>Sensación</dt><dd id="weather-feels">--°</dd></span></div>
            <div><img src={pressureIcon.src} width={pressureIcon.width} height={pressureIcon.height} alt="" /><span><dt>Presión</dt><dd id="weather-pressure">-- hPa</dd></span></div>
          </dl>
          </article>

          <aside class="air-card" aria-labelledby="air-title">
          <div class="air-heading">
            <span class="air-dot"></span>
            <div>
              <p class="card-kicker">Composición atmosférica</p>
              <h3 id="air-title">Calidad del aire</h3>
            </div>
          </div>
          <div class="aqi-row">
            <strong id="air-aqi">--</strong>
            <span id="air-label">Consultando AQI</span>
          </div>
          <dl class="pollutant-grid">
            <div><dt>PM2.5</dt><dd id="air-pm25">--</dd></div>
            <div><dt>PM10</dt><dd id="air-pm10">--</dd></div>
            <div><dt>NO₂</dt><dd id="air-no2">--</dd></div>
            <div><dt>O₃</dt><dd id="air-o3">--</dd></div>
          </dl>
          <p class="model-note">Estimación CAMS Global. No representa una estación local ni sustituye alertas oficiales.</p>
          </aside>
        </div>

        <section class="forecast-panel" aria-labelledby="forecast-title">
          <img class="forecast-landscape" src={landscape.src} width={landscape.width} height={landscape.height} alt="" aria-hidden="true" />
          <div class="forecast-heading"><h2 id="forecast-title">Pronóstico por días</h2><span>Máxima / mínima</span></div>
          <div id="forecast-list" class="forecast-list" aria-label="Pronóstico de cinco días">
            {Array.from({ length: 5 }).map(() => (
              <article class="forecast-card is-loading"><span></span><strong>--°</strong><small>--°</small></article>
            ))}
          </div>
        </section>
      </div>

      <p id="weather-status" class="weather-status" role="status" aria-live="polite"></p>
    </div>
  </section>

  <section id="guias-didacticas" class="section section-soft" aria-labelledby="guias-title">
    <div class="shell">
      <h2 id="guias-title" class="compact-title">Guías didácticas</h2>

      <div class="guide-grid">
        <article class="guide-card guide-primary">
          <img class="guide-icon" src={sunIcon.src} width={sunIcon.width} height={sunIcon.height} alt="" aria-hidden="true" />
          <h3>Introducción al clima</h3>
          <a class="button button-accent" href="/guias/introduccion-al-clima/">Abrir guía <span class="arrow">→</span></a>
        </article>

        <article class="guide-card guide-disabled">
          <img class="guide-icon" src={cloudIcon.src} width={cloudIcon.width} height={cloudIcon.height} alt="" aria-hidden="true" />
          <h3>Mapas meteorológicos</h3>
          <span class="disabled-button" aria-disabled="true">Próximamente</span>
        </article>

        <article class="guide-card guide-disabled">
          <img class="guide-icon" src={pressureIcon.src} width={pressureIcon.width} height={pressureIcon.height} alt="" aria-hidden="true" />
          <h3>Aplicaciones del clima</h3>
          <span class="disabled-button" aria-disabled="true">Próximamente</span>
        </article>
      </div>
    </div>
  </section>

  <section class="section apps-section" aria-labelledby="apps-title">
    <div class="shell">
      <h2 id="apps-title" class="compact-title">Aplicaciones útiles</h2>
      <div class="app-grid">
        <a class="app-card app-forecast" href="https://senamhi.gob.bo/index.php/meteorologia/pronostico" target="_blank" rel="noreferrer">
          <span class="app-icon">24°</span>
          <span><strong>Pronóstico oficial</strong><small>SENAMHI Bolivia</small></span>
          <b>↗</b>
        </a>
        <a class="app-card app-maps" href="https://www.ventusky.com/" target="_blank" rel="noreferrer">
          <span class="app-icon map-lines">≋</span>
          <span><strong>Mapas dinámicos</strong><small>Ventusky</small></span>
          <b>↗</b>
        </a>
        <a class="app-card app-alerts" href="https://senamhi.gob.bo/index.php/servicios/alerta-meteorologica" target="_blank" rel="noreferrer">
          <span class="app-icon">!</span>
          <span><strong>Alertas vigentes</strong><small>Fuente oficial</small></span>
          <b>↗</b>
        </a>
      </div>
    </div>
  </section>

  <script>
    import { CITIES, aqiInfo, loadClimateData, weatherInfo } from "../lib/openMeteo";

    const dashboard = document.querySelector<HTMLElement>("#weather-dashboard");
    const select = document.querySelector<HTMLSelectElement>("#city-select");
    const refresh = document.querySelector<HTMLButtonElement>("#weather-refresh");
    const forecastList = document.querySelector<HTMLElement>("#forecast-list");
    const status = document.querySelector<HTMLElement>("#weather-status");

    const text = (selector: string, value: string) => {
      const node = document.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };

    const number = (value: number, digits = 0) =>
      new Intl.NumberFormat("es-BO", { maximumFractionDigits: digits }).format(value);

    const dayName = (date: string) =>
      new Intl.DateTimeFormat("es-BO", { weekday: "short" })
        .format(new Date(`${date}T12:00:00`))
        .replace(".", "");

    function renderForecast(daily: Awaited<ReturnType<typeof loadClimateData>>["forecast"]["daily"]) {
      if (!forecastList) return;
      forecastList.innerHTML = daily.time.slice(0, 5).map((date, index) => {
        const condition = weatherInfo(daily.weather_code[index] ?? -1);
        const rain = daily.precipitation_probability_max[index] ?? 0;
        return `<article class="forecast-card">
          <p>${index === 0 ? "Hoy" : dayName(date)}</p>
          <span class="forecast-symbol" aria-hidden="true">${condition.symbol}</span>
          <strong>${number(daily.temperature_2m_max[index] ?? 0)}°</strong>
          <small>${number(daily.temperature_2m_min[index] ?? 0)}°</small>
          <em>${number(rain)}% lluvia</em>
          <span class="sr-only">${condition.label}</span>
        </article>`;
      }).join("");
    }

    async function updateWeather(force = false) {
      const city = CITIES.find((item) => item.id === select?.value) ?? CITIES[0];
      if (!city) return;

      dashboard?.setAttribute("aria-busy", "true");
      refresh?.classList.add("is-spinning");
      if (status) status.textContent = "Actualizando información atmosférica…";

      try {
        const data = await loadClimateData(city, force);
        const { forecast, airQuality } = data;
        const condition = weatherInfo(forecast.current.weather_code);
        text("#weather-location", `${city.name}, ${city.department}`);
        text("#weather-updated", `Actualizado ${forecast.current.time.slice(11)} · ${number(forecast.elevation)} m s. n. m.`);
        text("#weather-symbol", condition.symbol);
        text("#weather-temperature", `${number(forecast.current.temperature_2m)}°`);
        text("#weather-condition", condition.label);
        text("#weather-humidity", `${number(forecast.current.relative_humidity_2m)}%`);
        text("#weather-feels", `${number(forecast.current.apparent_temperature)}°`);
        text("#weather-wind", `${number(forecast.current.wind_speed_10m)} km/h`);
        text("#weather-pressure", `${number(forecast.current.surface_pressure)} hPa`);

        if (airQuality) {
          const aqi = aqiInfo(airQuality.current.us_aqi);
          text("#air-aqi", number(airQuality.current.us_aqi));
          text("#air-label", aqi.label);
          document.querySelector(".aqi-row")?.setAttribute("data-tone", aqi.tone);
          text("#air-pm25", `${number(airQuality.current.pm2_5, 1)} µg/m³`);
          text("#air-pm10", `${number(airQuality.current.pm10, 1)} µg/m³`);
          text("#air-no2", `${number(airQuality.current.nitrogen_dioxide, 1)} µg/m³`);
          text("#air-o3", `${number(airQuality.current.ozone, 1)} µg/m³`);
        } else {
          text("#air-label", "No disponible");
        }

        renderForecast(forecast.daily);
        if (status) status.textContent = data.stale
          ? "La API no respondió. Se muestran los últimos datos guardados."
          : "Datos actualizados correctamente.";
      } catch {
        if (status) status.innerHTML = "No pudimos consultar el clima. <button type=\"button\" id=\"weather-retry\">Intentar nuevamente</button>";
        document.querySelector<HTMLButtonElement>("#weather-retry")?.addEventListener("click", () => updateWeather(true));
      } finally {
        dashboard?.setAttribute("aria-busy", "false");
        refresh?.classList.remove("is-spinning");
      }
    }

    const savedCity = localStorage.getItem("atmosfera-ciudad");
    if (select && savedCity && CITIES.some((city) => city.id === savedCity)) select.value = savedCity;
    select?.addEventListener("change", () => {
      localStorage.setItem("atmosfera-ciudad", select.value);
      updateWeather();
    });
    refresh?.addEventListener("click", () => updateWeather(true));
    updateWeather();
  </script>
</BaseLayout>

<style>
  .weather-section {
    padding-block: 70px 88px;
  }

  .weather-toolbar,
  .forecast-heading,
  .current-topline,
  .air-heading,
  .aqi-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .weather-toolbar {
    align-items: end;
    margin-bottom: 30px;
  }

  .city-control {
    min-width: 260px;
  }

  .city-control span {
    display: block;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .city-control select {
    width: 100%;
    min-height: 48px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--white);
    color: var(--navy);
    padding: 9px 38px 9px 13px;
    font-weight: 750;
  }

  .weather-dashboard {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.8fr);
    gap: 20px;
  }

  .current-card,
  .air-card {
    border-radius: var(--radius-lg);
    padding: clamp(24px, 4vw, 40px);
  }

  .current-card {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: var(--white);
  }

  .current-card::after {
    position: absolute;
    top: -90px;
    right: -65px;
    width: 250px;
    height: 250px;
    border: 45px solid rgba(240, 229, 60, 0.11);
    border-radius: 50%;
    content: "";
  }

  .weather-location {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .weather-updated {
    margin: 3px 0 0;
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.78rem;
  }

  .refresh-button {
    position: relative;
    z-index: 2;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    background: transparent;
    color: var(--white);
    cursor: pointer;
    font-size: 1.3rem;
  }

  .refresh-button.is-spinning {
    animation: spin 800ms linear infinite;
  }

  .temperature-row {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 22px;
    margin-block: 22px 28px;
  }

  .weather-symbol {
    display: grid;
    width: 104px;
    height: 104px;
    place-items: center;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--navy);
    font-size: 4.5rem;
    line-height: 1;
  }

  .temperature {
    display: block;
    font-size: clamp(4rem, 9vw, 6.6rem);
    letter-spacing: -0.08em;
    line-height: 0.9;
  }

  .temperature-row p {
    margin: 9px 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-weight: 700;
  }

  .metric-grid,
  .pollutant-grid {
    display: grid;
    margin: 0;
  }

  .metric-grid {
    position: relative;
    z-index: 2;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .metric-grid div {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.07);
    padding: 12px;
  }

  dl dt {
    color: inherit;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    opacity: 0.65;
    text-transform: uppercase;
  }

  dl dd {
    margin: 4px 0 0;
    font-weight: 850;
  }

  .air-card {
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .air-heading {
    justify-content: flex-start;
  }

  .air-dot {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--cyan);
    box-shadow: inset 0 0 0 10px rgba(255, 255, 255, 0.55);
  }

  .card-kicker {
    margin: 0;
    color: var(--blue);
    font-size: 0.69rem;
    font-weight: 850;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .air-card h3 {
    margin: 2px 0 0;
    color: var(--navy);
    font-size: 1.25rem;
  }

  .aqi-row {
    justify-content: flex-start;
    margin-block: 27px;
  }

  .aqi-row strong {
    display: grid;
    width: 84px;
    height: 84px;
    place-items: center;
    border-radius: 50%;
    background: var(--green);
    color: var(--white);
    font-size: 2rem;
  }

  .aqi-row[data-tone="moderate"] strong { background: #a97800; }
  .aqi-row[data-tone="sensitive"] strong { background: var(--orange); }
  .aqi-row[data-tone="poor"] strong { background: var(--red); }

  .aqi-row span {
    color: var(--navy);
    font-size: 1.15rem;
    font-weight: 850;
  }

  .pollutant-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .pollutant-grid div {
    border-radius: 12px;
    background: var(--white);
    padding: 10px 12px;
  }

  .pollutant-grid dd {
    color: var(--navy);
    font-size: 0.85rem;
  }

  .model-note {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .weather-status {
    min-height: 26px;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .weather-status button {
    border: 0;
    background: transparent;
    color: var(--blue);
    cursor: pointer;
    font-weight: 800;
    text-decoration: underline;
  }

  .forecast-heading {
    margin-block: 24px 13px;
  }

  .forecast-heading h3 {
    margin: 0;
    color: var(--navy);
    font-size: 1.2rem;
  }

  .forecast-heading span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .forecast-list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  .forecast-card {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 5px 8px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--white);
    padding: 15px;
  }

  .forecast-card p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--navy);
    font-size: 0.83rem;
    text-transform: capitalize;
  }

  .forecast-symbol {
    grid-row: span 2;
    color: var(--blue);
    font-size: 2rem;
  }

  .forecast-card strong { color: var(--navy); }
  .forecast-card small { color: var(--muted); }

  .forecast-card em {
    grid-column: 1 / -1;
    color: var(--blue);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 750;
  }

  .forecast-card.is-loading {
    min-height: 123px;
    background: linear-gradient(100deg, var(--surface) 30%, #e7edf5 50%, var(--surface) 70%);
    background-size: 300% 100%;
    animation: shimmer 1.5s infinite;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    gap: 18px;
  }

  .guide-card {
    position: relative;
    overflow: hidden;
    min-height: 420px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--white);
    padding: 26px;
  }

  .guide-primary {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--white);
  }

  .guide-number {
    position: absolute;
    top: 17px;
    right: 20px;
    color: var(--navy);
    font-size: 0.75rem;
    font-weight: 850;
    opacity: 0.5;
  }

  .guide-primary .guide-number { color: var(--white); }

  .guide-illustration {
    position: relative;
    width: 100%;
    height: 150px;
    margin-bottom: 23px;
    border-radius: 16px;
    background: var(--blue-soft);
  }

  .atmosphere-illustration {
    overflow: hidden;
    background: var(--blue);
  }

  .atmosphere-sun {
    position: absolute;
    top: 18px;
    right: 23px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--yellow);
  }

  .atmosphere-earth {
    position: absolute;
    right: -15px;
    bottom: -67px;
    width: 190px;
    height: 190px;
    border: 24px solid var(--cyan);
    border-radius: 50%;
    background: var(--navy);
  }

  .atmosphere-illustration i {
    position: absolute;
    left: 20px;
    width: 95px;
    height: 2px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.7);
  }

  .atmosphere-illustration i:nth-of-type(1) { top: 43px; }
  .atmosphere-illustration i:nth-of-type(2) { top: 69px; width: 125px; }
  .atmosphere-illustration i:nth-of-type(3) { top: 95px; width: 72px; }

  .map-illustration span,
  .map-illustration i,
  .map-illustration b {
    position: absolute;
    border-radius: 46% 54% 62% 38%;
  }

  .map-illustration span { inset: 21px 90px 44px 23px; background: var(--green); transform: rotate(-12deg); }
  .map-illustration i { inset: 48px 21px 18px 105px; background: var(--blue); transform: rotate(14deg); }
  .map-illustration b { width: 38px; height: 38px; top: 23px; right: 42px; background: var(--yellow); }

  .app-illustration {
    background: var(--pink);
  }

  .app-illustration span {
    position: absolute;
    inset: 20px 65px;
    border: 6px solid var(--navy);
    border-radius: 18px;
    background: var(--white);
  }

  .app-illustration i,
  .app-illustration b {
    position: absolute;
    bottom: 36px;
    width: 13px;
    background: var(--blue);
  }

  .app-illustration i { left: 88px; height: 28px; }
  .app-illustration b { left: 109px; height: 52px; background: var(--orange); }

  .guide-card h3 {
    margin: 6px 0 8px;
    color: var(--navy);
    font-size: 1.45rem;
    line-height: 1.12;
  }

  .guide-primary h3 { color: var(--white); }

  .guide-card > p:not(.card-kicker) {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .guide-primary > p:not(.card-kicker) { color: rgba(255, 255, 255, 0.7); }
  .guide-card .button, .disabled-button { margin-top: auto; }

  .guide-disabled {
    background: #f4f5f7;
  }

  .disabled-button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    border: 1px dashed #aeb7c6;
    border-radius: 999px;
    background: #e4e7ec;
    color: #788395;
    padding: 10px 19px;
    cursor: not-allowed;
    font-size: 0.84rem;
    font-weight: 800;
  }

  .app-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .app-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 15px;
    min-height: 132px;
