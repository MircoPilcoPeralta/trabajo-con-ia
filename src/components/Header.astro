---
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const navItems = [
  { href: "/", label: "Inicio", match: (path: string) => path === "/" },
  { href: "/pronostico/", label: "Pronóstico", match: (path: string) => path.startsWith("/pronostico") },
  { href: "/guias/", label: "Guías", match: (path: string) => path.startsWith("/guias") },
  { href: "/comparaciones/", label: "Comparaciones", match: (path: string) => path.startsWith("/comparaciones") },
];
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label="Física de la Atmósfera, página de inicio">
      <svg class="brand-mark" viewBox="0 0 52 52" aria-hidden="true">
        <circle cx="36" cy="15" r="9" fill="currentColor" class="brand-sun"></circle>
        <path d="M9 35c0-7 5-12 12-12 5 0 9 3 11 7 1-1 3-1 5-1 5 0 9 4 9 9s-4 9-9 9H13a7 7 0 0 1-4-12Z" fill="currentColor"></path>
      </svg>
      <span>
        <strong>Física de la Atmósfera</strong>
        <small>Tu clima, tu día.</small>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
      <span class="sr-only">Abrir menú principal</span>
      <span></span><span></span><span></span>
    </button>

    <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a href={item.href} aria-current={item.match(pathname) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>(".main-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    nav?.classList.toggle("is-open", !isOpen);
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      nav.classList.remove("is-open");
    });
  });
</script>
